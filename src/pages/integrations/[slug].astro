---
import CatalogPage from '../../components/CatalogPage.astro';
import { integrations, type CatalogItem } from '../../data/catalog';
export function getStaticPaths() {
  return integrations.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: CatalogItem };
---
<CatalogPage item={item} all={integrations} section="Integrations" base="/integrations" />
