---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, industryTheme, type IndustryKey } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  industry?: IndustryKey;
  showFooterCta?: boolean;
}
const { title, description = site.description, industry, showFooterCta = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.brand}` : `${site.brand} — Business software for Kenyan fuel, retail, restaurants and pharmacies`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const theme = industry ? industryTheme[industry] : null;
const accentVars = theme
  ? `--accent:${theme.bg};--accent-fg:${theme.fg};--accent-text:${theme.text};--accent-soft:${theme.soft};`
  : '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content={theme ? theme.bg : '#ECEEEB'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_KE" />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.legalName,
    url: Astro.site?.toString(),
    address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'KE' },
  })} />
</head>
<body style={accentVars}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header industry={industry} />
  <main id="main">
    <slot />
  </main>
  <Footer showCta={showFooterCta} />
</body>
</html>
